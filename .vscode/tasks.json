{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Jarvis: Build",
			"type": "process",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd run build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Jarvis: Test",
			"type": "process",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Jarvis: Start Chat",
			"type": "process",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd run chat"
			],
			"isBackground": false,
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"OPENROUTER_API_KEY": "${input:openrouterApiKey}"
				}
			}
		},
		{
			"label": "Jarvis: OpenRouter Check (Free)",
			"type": "process",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd run openrouter:live-test"
			],
			"isBackground": false,
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"OPENROUTER_API_KEY": "${input:openrouterApiKey}"
				}
			}
		}
	],
	"inputs": [
		{
			"id": "openrouterApiKey",
			"type": "promptString",
			"description": "OpenRouter API key (entered locally; free router only)",
			"password": true
		}
	]
}
