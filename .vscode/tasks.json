{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Jarvis",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd run build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Run Jarvis tests",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm.cmd test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check OpenRouter connection (free only)",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"openrouter:live-test"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"shell": {
					"executable": "C:\\Windows\\System32\\cmd.exe",
					"args": [
						"/d",
						"/c"
					]
				},
				"env": {
					"OPENROUTER_API_KEY": "${input:openrouterApiKey}"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true
			},
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Jarvis chat (free only)",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"chat"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"shell": {
					"executable": "C:\\Windows\\System32\\cmd.exe",
					"args": [
						"/d",
						"/c"
					]
				},
				"env": {
					"OPENROUTER_API_KEY": "${input:openrouterApiKey}"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": false
			},
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Jarvis conversation integration",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Jarvis conversation tests",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate conversation memory integration",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final Jarvis build and tests",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final Jarvis conversation validation",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Jarvis CLI",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Test Jarvis CLI",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final Jarvis CLI validation",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "openrouterApiKey",
			"type": "promptString",
			"description": "OpenRouter API key (entered locally; free router only)",
			"password": true
		}
	]
}